{
    "name": "freya-ng",
    "version": "15.1.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "backend": "node server.js",
        "dev:lan": "concurrently \"ng serve --host 0.0.0.0\" \"npm run backend\"",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint",
        "start:frontend": "ng serve --host 0.0.0.0 --disable-host-check",
        "start:backend": "node server.js",
        "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
    },
    "private": true,
